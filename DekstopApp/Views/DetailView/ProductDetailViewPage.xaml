<UserControl x:Class="DekstopApp.Views.DetailViewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Back Button -->
            <RowDefinition Height="*" />     <!-- Product Details -->
            <RowDefinition Height="Auto" />  <!-- Comment Input -->
            <RowDefinition Height="Auto" />  <!-- Add Comment Button -->
            <RowDefinition Height="*" />     <!-- Comments List -->
            <RowDefinition Height="Auto" />  <!-- Add to Cart Button -->

        </Grid.RowDefinitions>

        <!-- Back Button -->
        <Button Grid.Row="0"
                Content="← Назад"
                HorizontalAlignment="Left"
                Background="Black"
                Foreground="White"
                Margin="10"
                Click="OnGoBackNavigationClick" />

        <!-- Product Detail Content -->
        <ScrollViewer Grid.Row="1" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Product Image -->
                <Border Grid.Column="0"
                        Background="White"
                        Margin="10"
                        CornerRadius="5"
                        BorderBrush="#DDD"
                        BorderThickness="1">
                    <Image Source="{Binding SelectedProduct.ImageUrl}"
                           Stretch="Uniform" />
                </Border>

                <!-- Product Info -->
                <StackPanel Grid.Column="1" Margin="20">
                    <TextBlock Text="{Binding SelectedProduct.Name}"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0 0 0 10" />

                    <TextBlock Text="{Binding SelectedProduct.Price}"
                               FontSize="20"
                               Foreground="#222265"
                               Margin="0 0 0 20" />

                    <TextBlock Text="{Binding SelectedProduct.Description}"
                               TextWrapping="Wrap"
                               FontSize="16"
                               Margin="0 0 0 30" />

                    <!-- Quantity Selector -->
                    <StackPanel Orientation="Horizontal" Margin="0 20 0 0">
                        <TextBlock Text="Количество: "
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Margin="0 0 10 0" />
                        <TextBlock Text="{Binding SelectedProduct.Quantity}"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="0 0 10 0" />
                    </StackPanel>

                    <!-- In development -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Выберите размер:"
                                   FontSize="14"
                                   Margin="0 0 10 0" />
                        <ComboBox ItemsSource="{Binding SelectedProduct.Sizes}"
                                  SelectedItem="{Binding SelectedProduct.SelectedSize}"
                                  Width="200"
                                  Margin="0 0 0 20" />

                        <TextBlock Text="Выберите цвет:"
                                   FontSize="14"
                                   Margin="0 0 10 0" />
                        <ComboBox ItemsSource="{Binding SelectedProduct.Colors}"
                                  SelectedItem="{Binding SelectedProduct.SelectedColor}"
                                  Width="200" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="10">
                        <!-- Отзыв -->
                        <TextBlock Text="Отличный товар, качество супер!"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,5" />

                        <!-- Рейтинг (звёзды) -->
                        <StackPanel Orientation="Horizontal">
                            <!-- Звезды -->
                            <TextBlock Text="★" Foreground="Gold" FontSize="20" />
                            <TextBlock Text="★" Foreground="Gold" FontSize="20" />
                            <TextBlock Text="★" Foreground="Gold" FontSize="20" />
                            <TextBlock Text="★" Foreground="Gold" FontSize="20" />
                            <TextBlock Text="☆" Foreground="Gray" FontSize="20" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBox Grid.Row="2" Text="{Binding NewCommentText}" />
        <!-- -->
        <!-- <xctk:Rating Grid.Row="3"  -->
        <!--              Value="{Binding SelectedRating, Mode=TwoWay}" -->
        <!--              Maximum="5" -->
        <!--              HorizontalAlignment="Left" -->
        <!--              Margin="0 10"/> -->
        <!-- -->
        <!-- <Button Grid.Row="4"  -->
        <!--         Command="{Binding AddRatingCommand}" -->
        <!--         Content="Submit Rating"  -->
        <!--         HorizontalAlignment="Left"/> -->
        
        <Button Grid.Row="3" Command="{Binding AddCommentCommand}"
                CommandParameter="{Binding NewCommentText}"
                Content="Add Comment" />


        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0 40 0 0">
            <ItemsControl ItemsSource="{Binding Comments}"
                          Margin="20 0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray"
                                BorderThickness="0 0 0 1"
                                Padding="0 5"
                                Margin="0 5">
                            <StackPanel>
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           FontSize="14" />
                                <TextBlock Text="{Binding CreatedAt, StringFormat='Добавлено: {0:dd.MM.yyyy HH:mm}'}"
                                           FontSize="12"
                                           Foreground="Gray" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Add to Cart Button -->
        <Button Grid.Row="5"
                Content="Добавить в корзину"
                HorizontalAlignment="Stretch"
                Margin="20"
                Padding="15 5"
                Background="Black"
                Foreground="White"
                FontSize="16"
                Command="{Binding AddToCartCommand}" />
    </Grid>
</UserControl>