<UserControl x:Class="DekstopApp.Views.RegisterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DekstopApp.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:global="clr-namespace:"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="400">

    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Margin" Value="0 10 0 0" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
            <Setter Property="Margin" Value="0 10 0 0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#FFF5F5F5">
        <Border CornerRadius="10" Background="#FFF5F5F5"
                Width="350" VerticalAlignment="Center" HorizontalAlignment="Center">

            <StackPanel>
                <!-- Header -->
                <TextBlock Text="Create Account"
                           FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0 0 0 20"
                           Foreground="#FFD700" />

                <!-- Form -->
                <!-- <TextBox materialDesign:HintAssist.Hint="Full Name" -->
                <!--          Style="{StaticResource MaterialDesignOutlinedTextBox}" -->
                <!--          Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" /> -->

                <TextBox materialDesign:HintAssist.Hint="Email"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                <PasswordBox x:Name="PasswordBox"
                             materialDesign:HintAssist.Hint="Password"
                             Margin="0 0 0 20"/>

                <!-- <PasswordBox materialDesign:HintAssist.Hint="Confirm Password" -->
                <!--              Style="{StaticResource MaterialDesignOutlinedPasswordBox}" -->
                <!--              Password="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" -->
                <!--              Margin="0 10 0 20" /> -->

                <!-- Register Button -->
                <Button Content="REGISTER"
                        Click="OnRegisterButtonClick"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#FFD700" Foreground="White"
                        Height="45" FontSize="14" FontWeight="Bold" />

                <!-- Login Link -->
                <TextBlock Margin="0 15 0 0" HorizontalAlignment="Center">
                    <Run Text="Already have an account?" />
                    <Hyperlink Click="OnLoginNavigationClick"
                               Foreground="#FFD700" FontWeight="Bold">
                        Sign In
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>