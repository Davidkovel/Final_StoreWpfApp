<UserControl x:Class="DekstopApp.Views.CartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DekstopApp.Views"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- First Header (Naviagation items) -->
            <RowDefinition Height="Auto" />  <!-- Second Header (Your items / your cart) -->
            <RowDefinition Height="*" />     <!-- Main Content -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFD700" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />  <!-- Logo -->
                    <ColumnDefinition Width="*" />     <!-- Navigation -->
                    <ColumnDefinition Width="Auto" />  <!-- User Actions -->
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <TextBlock Grid.Column="0"
                           Text="MyShop"
                           Foreground="Black"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />

                <!-- Navigation -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="Товары"
                            Margin="10 0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="Black"
                            FontWeight="Bold"
                            Click="OnGoHomePageNavigationClick" />
                    <Button Content="О нас"
                            Margin="10 0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="Black"
                            FontWeight="Bold" />
                </StackPanel>

                <!-- User Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Войти"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="Black"
                            FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>


        <!-- Second Header (Your items / your cart) -->
        <Border Grid.Row="1" Background="White" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- TextBlock по центру -->
                <TextBlock
                    Grid.Column="1"
                    Text="Your Cart"
                    Foreground="Black"
                    FontSize="18"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Основное содержимое корзины -->
                <ItemsControl Grid.Column="0" ItemsSource="{Binding CartItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200"
                                    Height="300"
                                    Background="White"
                                    Margin="10"
                                    CornerRadius="5"
                                    BorderBrush="#DDD"
                                    BorderThickness="1">
                                <StackPanel>
                                    <!-- Изображение товара -->
                                    <Border Height="120" Background="#EEE">
                                        <Image Source="{Binding ProductImageUrl}"
                                               Stretch="Uniform" />
                                    </Border>

                                    <!-- Информация о товаре -->
                                    <StackPanel Margin="10">
                                        <TextBlock Text="{Binding ProductName}"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ProductPrice, StringFormat='{}{0:C}'}"
                                                   Foreground="#222265"
                                                   Margin="0 5 0 0" />
                                    </StackPanel>

                                    <!-- Управление количеством -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0 10">
                                        <Button Content="-"
                                                Width="30"
                                                Command="{Binding DecreaseQuantityCommand}" 
                                                CommandParameter="{Binding ProductId}"/>
                                        <TextBlock Text="{Binding Quantity}"
                                                   Width="30"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Button Content="+"
                                                Width="30"
                                                Command="{Binding IncreaseQuantityCommand}"
                                                CommandParameter="{Binding ProductId}"/>
                                    </StackPanel>

                                    <!-- Удалить из корзины -->
                                    <Button Content="Удалить"
                                            Margin="10"
                                            Background="#FF4444"
                                            Foreground="White"
                                            Command="{Binding DataContext.DeleteCartItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding ProductId}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Панель итогов справа -->
                <Border Grid.Column="1"
                        Background="#F5F5F5"
                        Margin="20"
                        Padding="20"
                        CornerRadius="5"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        Width="250">
                    <StackPanel>
                        <TextBlock Text="Ваша корзина"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0 0 0 10" />

                        <Separator Margin="0 0 0 10" />

                        <StackPanel>
                            <TextBlock Text="{Binding TotalItems, StringFormat='Товаров: {0}'}"
                                       FontSize="14" />
                            <TextBlock Text="{Binding SubTotal, StringFormat='Подытог: {0:C}'}"
                                       FontSize="14"
                                       Margin="0 5" />
                            <TextBlock Text="{Binding Tax, StringFormat='Налог: {0:C}'}"
                                       FontSize="14" />
                        </StackPanel>

                        <Separator Margin="0 10" />

                        <TextBlock Text="{Binding Total, StringFormat='Итого: {0:C}'}"
                                   FontSize="16"
                                   FontWeight="Bold" />

                        <Button Content="Оформить заказ"
                                Margin="0 20 0 0"
                                Padding="15 5"
                                Background="#FFD700"
                                FontWeight="Bold"
                                Command="{Binding CheckoutCommand}" />

                        <Button Content="Очистить корзину"
                                Margin="0 10 0 0"
                                Foreground="#FF4444"
                                Background="Transparent"
                                Command="{Binding ClearCartItemsCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>