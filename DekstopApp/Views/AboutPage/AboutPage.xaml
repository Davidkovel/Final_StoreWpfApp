<UserControl x:Class="DekstopApp.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- First Header (About/Products) -->
            <RowDefinition Height="Auto" />  <!-- Second Header (Black - Product List View) -->
            <RowDefinition Height="*" />     <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- First Header (Yellow) -->
        <Border Grid.Row="0" Background="#FFD700" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />  <!-- Logo -->
                    <ColumnDefinition Width="*" />     <!-- Navigation -->
                    <ColumnDefinition Width="Auto" />  <!-- User Actions -->
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <TextBlock Grid.Column="0"
                           Text="MyShop"
                           Foreground="Black"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />

                <!-- Navigation -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="Товары"
                            Margin="10 0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="Black"
                            FontWeight="Bold" 
                            Click="OnGoHomePageNavigationClick"/>
                    <Button Content="Корзина"
                            Margin="10 0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="Black"
                            FontWeight="Bold"
                            Click="OnGoCartPageNavigationClick" />
                    <Button Content="О нас"
                            Margin="10 0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="Black"
                            FontWeight="Bold" />
                    <Button x:Name="LoginButton"
                            Content="Login"
                            Margin="10 0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="Black"
                            FontWeight="Bold"
                            Click="OnGoLoginPageNavigationClick" />
                    <Button x:Name="ProfileButton"
                            Content="Profile"
                            Margin="10 0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="Black"
                            FontWeight="Bold"
                            Visibility="Collapsed" />


                </StackPanel>
            </Grid>
        </Border>

        <!-- Second Header (Black - Product List View) -->
        <Border Grid.Row="1" Background="Black" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Categories list view -->
                <Menu Grid.Column="0" VerticalAlignment="Center">
                    <MenuItem Header="Каталог"
                              Foreground="#FFD700"
                              FontWeight="Bold">
                        <!-- Все товары -->
                        <MenuItem Header="Все товары"
                                  Command="{Binding FilterByCategoryCommand}"
                                  CommandParameter="{x:Null}"
                                  Foreground="#FFD700" />

                        <Separator />

                        <MenuItem Header="Категории"
                                  Foreground="#FFD700">
                            <MenuItem.ItemsSource>
                                <Binding Path="Categories" />
                            </MenuItem.ItemsSource>
                            <MenuItem.ItemTemplate>
                                <DataTemplate>
                                    <MenuItem Header="{Binding Name}"
                                              Command="{Binding DataContext.FilterByCategoryCommand, 
                                              RelativeSource={RelativeSource AncestorType=Menu}}"
                                              CommandParameter="{Binding Id}"
                                              Foreground="#FFD700" />
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                        </MenuItem>
                    </MenuItem>
                </Menu>


                <!-- TextBlock по центру -->
                <TextBlock
                    Grid.Column="1"
                    Text="PRODUCT LIST VIEW"
                    Foreground="#FFD700"
                    FontSize="18"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <Image Source="C:\Users\David\RiderProjects\StoreWpfApp\Data\Persistence\Images\88-shop.jpg"
                   Width="500"
                   Height="250"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20" />

            <TextBlock HorizontalAlignment="Center"
                       TextAlignment="Center"
                       MaxWidth="600"
                       Margin="0,0,0,20">
                <Run Text="Добро пожаловать в наш магазин!" FontWeight="Bold" />
                <LineBreak />
                <Run Text="Мы предлагаем качественные товары по доступным ценам." />
                <LineBreak />
                <Run Text="Работаем с 2010 года и дорожим каждым клиентом." />
                <LineBreak />
                <LineBreak />
                <Run Text="График работы: Пн-Пт — 9:00-20:00, Сб-Вс — 10:00-18:00" FontStyle="Italic" />
            </TextBlock>

            <!-- Контактные данные (телефон + почта) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="📞 Контактный телефон: "
                           FontSize="16"
                           FontWeight="Bold" />
                <TextBlock Text=" +351 925412364"
                           FontSize="16"
                           Foreground="Blue" />
                <Separator Width="20" Background="Transparent" />
                <TextBlock Text="✉ Почта: "
                           FontSize="16"
                           FontWeight="Bold" />
                <TextBlock Foreground="Blue">
                    <TextBlock Text=" dkovel7@gmail.com" FontSize="16" />
                </TextBlock>
            </StackPanel>

            <!-- Дополнительный разделитель -->
            <Separator Width="400" Margin="0,10" Background="LightGray" />
        </StackPanel>
    </Grid>
</UserControl>